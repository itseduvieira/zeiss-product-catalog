{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build API",
      "program": "${workspaceFolder}/backend/src/ProductCatalog.Api/bin/Debug/net10.0/ProductCatalog.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/ProductCatalog.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5158"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "App",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start app",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "API + App",
      "configurations": ["API", "App"],
      "stopAll": true
    }
  ]
}
