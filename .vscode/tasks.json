{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/src/ProductCatalog.Api/ProductCatalog.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test API",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/backend"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "start app",
      "type": "npm",
      "script": "start",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "build app",
      "type": "npm",
      "script": "build",
      "path": "frontend",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "test app",
      "type": "process",
      "command": "npm",
      "args": ["test", "--", "--no-watch"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
